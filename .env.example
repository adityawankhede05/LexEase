# ==========================================
# LexEase Environment Configuration
# ==========================================

# Active AI Provider: "groq", "openrouter", or "gemini"
AI_PROVIDER=groq

# Groq AI Provider Config
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=30

# OpenRouter AI Provider Config
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT=30

# Google Gemini AI Provider Config
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT=30

# General AI Settings
MAX_RETRIES=3

# Database Config
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lexease

# Backend Server Config
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Config
VITE_BACKEND_URL=http://localhost:8000
